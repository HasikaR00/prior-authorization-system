"""
Shared connection helper. All loader scripts import get_connection() from here
instead of hardcoding credentials. Set these via environment variables, or
just edit the defaults below for local hackathon use.

Requires: pip install mysql-connector-python
"""
import os
import mysql.connector
from dotenv import load_dotenv

load_dotenv()

DB_CONFIG = {
    "host": os.getenv("DB_HOST", os.getenv("MYSQL_HOST", "localhost")),
    "port": int(os.getenv("DB_PORT", "3306")),
    "user": os.getenv("DB_USER", os.getenv("MYSQL_USER", "root")),
    "password": os.getenv("DB_PASSWORD", os.getenv("MYSQL_PASSWORD", "")),
    "database": os.getenv("DB_NAME", os.getenv("MYSQL_DATABASE", "pa_system")),
}


def get_connection():
    return mysql.connector.connect(**DB_CONFIG)